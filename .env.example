# Copy to .env:  copy .env.example .env
#
# Hugging Face and Groq are optional. Needed when that provider is selected
# or as fallback if the preferred provider fails.
# Tokens: https://huggingface.co/settings/tokens  https://console.groq.com/keys
HF_TOKEN=
GROQ_API_KEY=
HF_DEFAULT_DAILY_LIMIT=50
# Groq cap is Free-plan RPD/RPM per model (see https://console.groq.com/docs/rate-limits).
GROQ_DEFAULT_DAILY_LIMIT=1000

HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
# DeepSeek via Hugging Face Inference Providers (same HF_TOKEN).
HF_DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Router host for HF models. auto lets Hugging Face pick a supported provider.
# Override only if you have that host enabled: novita, fireworks-ai, nebius, …
HF_PROVIDER=auto
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=120

# Redis cache for grammar + tenses (12 hour TTL). Docker Compose sets redis://redis:6379/0.
# Railway: add a Redis plugin; REDIS_URL / REDIS_PRIVATE_URL are injected.
# Local uvicorn without Compose: redis://127.0.0.1:6379/0 after `docker compose up redis`.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=43200

NEXT_PUBLIC_API_URL=https://deeplm.up.railway.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://deep-lm.vercel.app
