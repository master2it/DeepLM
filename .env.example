# Copy to .env next to language.py for LOCAL DEVELOPMENT only:
#   copy .env.example .env
#
# Packaged translator.exe does NOT use .env — set a Windows env var instead:
#   setx HF_TOKEN "hf_your_token_here"
# Then restart CMD/PowerShell and the app. Verify:  echo %HF_TOKEN%

# HuggingFace — used for ALL AI features (tenses, grammar, translate modal)
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token

# Optional overrides
# HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct
