# Copy to .env:  copy .env.example .env
#
# Hugging Face is optional. Needed only when Ollama is down.
# Create a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# Local uvicorn (on the host). Docker Compose overrides this to
# http://host.docker.internal:11434 inside the backend container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1
HF_CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
